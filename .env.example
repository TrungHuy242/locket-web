# set to 1 when serving over HTTPS so the session cookie is never sent in clear text
LOCKET_COOKIE_SECURE=0
# where sessions (Firebase tokens), synced moment history and the thumbnail cache are stored
# LOCKET_DATA_DIR=backend/data
# disk cache limits (MB) and idle in-memory session eviction (seconds)
# LOCKET_THUMBS_MAX_MB=150
# LOCKET_VIDEO_CACHE_MAX_MB=500
# LOCKET_SESSION_IDLE_SECONDS=43200
# backend log level (DEBUG, INFO, WARNING, ERROR)
# LOCKET_LOG_LEVEL=INFO
# optional persistent state sync to a PRIVATE Hugging Face Dataset (for Hugging Face Spaces / free PaaS)
# LOCKET_HF_REPO=your-username/locket-data
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxx
# optional passphrase to encrypt sessions & history before uploading to the private dataset
# LOCKET_BACKUP_KEY=change-me-to-a-long-random-passphrase
